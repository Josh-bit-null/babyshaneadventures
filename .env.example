# ─────────────────────────────────────────────────────────────────────────────
# BabyShaneAdventures — copy to .env and fill in.
# Vite reads this file too (envDir points at the repo root), so keep VITE_* here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated list of browser origins allowed by Express CORS + Socket.IO.
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the deployed app (used in production when the API is same-origin).
PUBLIC_ORIGIN=http://localhost:3001
SOCKET_PATH=/socket.io
# Socket.IO / state broadcast rate. The game is tuned for 20 ticks per second.
TICK_RATE=20

# ── Sessions ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_TTL=7d
COOKIE_NAME=bsa_token
# Set true when served over HTTPS (required for Secure cookies).
COOKIE_SECURE=false

# ── MariaDB (primary persistence) ────────────────────────────────────────────
# When DATABASE_URL is set, the server uses MariaDB/MySQL exclusively.
# Example: mysql://bsa:bsa@127.0.0.1:3306/babyshane
DATABASE_URL=
# Discrete fallback if your provider does not expose a URI:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bsa
DB_PASSWORD=bsa
DB_NAME=babyshane
DB_POOL_SIZE=10

# Local development fallback when DATABASE_URL is empty: Node's built-in SQLite.
# The exact same three tables are created. Never used when DATABASE_URL is set.
SQLITE_PATH=./server/data/babyshane.sqlite

# ── Google Gemini (PDF → 10-question quiz) ───────────────────────────────────
# Server-side only. Never exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Client build-time config ─────────────────────────────────────────────────
# Optional Cloudflare R2 public base URL hosting the low-poly .glb packs.
# Layout must mirror /client/public/models (furniture/, nature/, pets/, house/).
# Example: https://assets.babyshane.co/models
VITE_R2_ASSET_BASE_URL=
# Optional API origin if client and server are deployed to different hosts.
VITE_API_BASE_URL=
# Toggle service-worker registration (default true).
VITE_ENABLE_SW=true
# Hard ceiling for shipped payload (models + fonts + tessdata + build output).
VITE_MAX_ASSET_BYTES=18000000
